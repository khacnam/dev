# Server Configuration
HTTP_PORT=3000
RTMP_PORT=1935

# Domain/IP của server (thay đổi thành IP hoặc domain thực của bạn)
DOMAIN=your-server-ip-or-domain

# JWT Secret Key (thay đổi thành một chuỗi ngẫu nhiên phức tạp)
JWT_SECRET=change-this-to-a-random-secret-key

# FFmpeg path (mặc định cho Ubuntu)
FFMPEG_PATH=/usr/bin/ffmpeg
